{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": null,
  "installCommand": null,
  "outputDirectory": null,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/",
      "destination": "/src/pages/top.html"
    },
    {
      "source": "/tatami",
      "destination": "/src/pages/tatami.html"
    },
    {
      "source": "/products",
      "destination": "/src/pages/products.html"
    },
    {
      "source": "/works",
      "destination": "/src/pages/works.html"
    },
    {
      "source": "/company-story",
      "destination": "/src/pages/company-story.html"
    }
  ],
  "redirects": [
    {
      "source": "/top",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/top.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/tatami.html",
      "destination": "/tatami",
      "permanent": true
    },
    {
      "source": "/works.html",
      "destination": "/works",
      "permanent": true
    },
    {
      "source": "/products.html",
      "destination": "/products",
      "permanent": true
    },
    {
      "source": "/price.html",
      "destination": "/products#price",
      "permanent": true
    },
    {
      "source": "/service.html",
      "destination": "/products",
      "permanent": true
    },
    {
      "source": "/concerns.html",
      "destination": "/tatami#faq",
      "permanent": true
    },
    {
      "source": "/types.html",
      "destination": "/products#types",
      "permanent": true
    },
    {
      "source": "/company.html",
      "destination": "/company-story#info",
      "permanent": true
    },
    {
      "source": "/company",
      "destination": "/company-story#info",
      "permanent": true
    },
    {
      "source": "/price",
      "destination": "/products#price",
      "permanent": true
    },
    {
      "source": "/service",
      "destination": "/products",
      "permanent": true
    },
    {
      "source": "/types",
      "destination": "/products#types",
      "permanent": true
    },
    {
      "source": "/concerns",
      "destination": "/tatami#faq",
      "permanent": true
    },
    {
      "source": "/company-story.html",
      "destination": "/company-story",
      "permanent": true
    },
    {
      "source": "/contact.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/contact",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/src/pages/top.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/src/pages/:page.html",
      "destination": "/:page",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/photos/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/design/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600"
        }
      ]
    }
  ]
}
