{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": null,
  "installCommand": null,
  "outputDirectory": null,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/",
      "destination": "/src/pages/top.html"
    },
    {
      "source": "/tatami",
      "destination": "/src/pages/tatami.html"
    },
    {
      "source": "/products",
      "destination": "/src/pages/products.html"
    },
    {
      "source": "/works",
      "destination": "/src/pages/works.html"
    },
    {
      "source": "/company-story",
      "destination": "/src/pages/company-story.html"
    },
    {
      "source": "/privacy",
      "destination": "/src/pages/privacy.html"
    }
  ],
  "redirects": [
    {
      "source": "/top",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/top.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/tatami.html",
      "destination": "/tatami",
      "permanent": true
    },
    {
      "source": "/works.html",
      "destination": "/works",
      "permanent": true
    },
    {
      "source": "/products.html",
      "destination": "/products",
      "permanent": true
    },
    {
      "source": "/price.html",
      "destination": "/products#price",
      "permanent": true
    },
    {
      "source": "/service.html",
      "destination": "/products",
      "permanent": true
    },
    {
      "source": "/concerns.html",
      "destination": "/tatami#faq",
      "permanent": true
    },
    {
      "source": "/types.html",
      "destination": "/products#types",
      "permanent": true
    },
    {
      "source": "/company.html",
      "destination": "/company-story#info",
      "permanent": true
    },
    {
      "source": "/company",
      "destination": "/company-story#info",
      "permanent": true
    },
    {
      "source": "/price",
      "destination": "/products#price",
      "permanent": true
    },
    {
      "source": "/service",
      "destination": "/products",
      "permanent": true
    },
    {
      "source": "/types",
      "destination": "/products#types",
      "permanent": true
    },
    {
      "source": "/concerns",
      "destination": "/tatami#faq",
      "permanent": true
    },
    {
      "source": "/company-story.html",
      "destination": "/company-story",
      "permanent": true
    },
    {
      "source": "/privacy.html",
      "destination": "/privacy",
      "permanent": true
    },
    {
      "source": "/contact.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/contact",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/src/pages/top.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/src/pages/:page.html",
      "destination": "/:page",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline' https://www.googletagmanager.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https://www.googletagmanager.com https://www.google-analytics.com; connect-src 'self' https://www.google-analytics.com https://*.google-analytics.com https://*.analytics.google.com https://*.googletagmanager.com; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'; upgrade-insecure-requests"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=(), magnetometer=(), gyroscope=(), accelerometer=(), midi=(), serial=(), bluetooth=()"
        },
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin"
        },
        {
          "key": "X-DNS-Prefetch-Control",
          "value": "on"
        }
      ]
    },
    {
      "source": "/photos/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/design/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600"
        }
      ]
    },
    {
      "source": "/llms.txt",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/plain; charset=utf-8"
        }
      ]
    }
  ]
}
